# python scripts/init_env.py 가 무작위 비밀값으로 .env를 생성합니다.
DJANGO_SECRET_KEY=REPLACE_DJANGO_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MYSQL_DATABASE=mafia
MYSQL_USER=mafia
MYSQL_PASSWORD=REPLACE_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
MYSQL_HOST=db
MYSQL_PORT=3306
APP_PORT=8080
COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
DISCONNECT_GRACE_SECONDS=30
